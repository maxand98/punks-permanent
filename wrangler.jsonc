{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "punks-permanent",
  "main": "worker.ts",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "cryptopunks.website",
      "custom_domain": true
    },
    {
      "pattern": "www.cryptopunks.website",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}

